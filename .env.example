# Banco de dados: conexão de runtime via Supavisor (porta 6543)
DATABASE_URL="postgresql://<role>.<project-ref>:[senha]@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Banco de dados: pooler em modo sessão usado pelo Prisma Migrate (porta 5432)
DIRECT_URL="postgresql://<role>.<project-ref>:[senha]@<pooler-host>:5432/postgres?connection_limit=1&sslmode=require"

# Supabase Auth
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<supabase-anon-key>"

# Compatibilidade: o servidor também reconhece NEXT_PUBLIC_SUPABASE_URL e
# NEXT_PUBLIC_SUPABASE_ANON_KEY já usados pelo protótipo. Somente URL/chave pública.
# Nunca atribua prefixo NEXT_PUBLIC_ à service_role ou às URLs PostgreSQL.
# Na Vercel, configure as variáveis de produção nas configurações do projeto.
# Este arquivo serve como modelo para configuração.

# Desenvolvimento local: crie .env.local (ignorado), sobrescrevendo APENAS:
# DATABASE_URL="postgresql://empresti:empresti_local@127.0.0.1:5433/empresti"
# DIRECT_URL="postgresql://empresti:empresti_local@127.0.0.1:5433/empresti"

# Rastreamento de erros
SENTRY_DSN="https://<public-key>@o<org-id>.ingest.sentry.io/<project-id>"
